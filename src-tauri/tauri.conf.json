{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamic Downloading Dashboard",
  "mainBinaryName": "dynamic-downloading-dashboard",
  "version": "1.0.0",
  "identifier": "io.github.jasimsiddiqui.ddd",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dynamic Downloading Dashboard",
        "width": 1040,
        "height": 700,
        "minWidth": 600,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "A fast, free download manager.",
    "longDescription": "Dynamic Downloading Dashboard speeds up downloads by pulling each file over many connections at once. It handles links, videos, streams and torrents, all on your own computer.",
    "copyright": "Copyright (C) 2026 Jasim Siddiqui. GPL-3.0.",
    "publisher": "Jasim Siddiqui",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
